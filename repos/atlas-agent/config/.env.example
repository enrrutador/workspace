# Atlas Agent Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM ──────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# En el catálogo NVIDIA la cuenta opera con: meta/muse-glimmer-30b y
# stepfun-ai/step-5-preview (step-5 hace tool-calling correcto y rápido).
# Models reasoning: necesitan presupuestos altos (ver below 32K).
MODEL_NAME=stepfun-ai/step-5-preview
# Clasificador y descomponer: default env (mismo modelo sirve).
# CLASSIFIER_MODEL=stepfun-ai/step-5-preview
# Clasificador reasoning: cientos de tokens de "thinking" antes de responder.
CLASSIFIER_MAX_TOKENS=256
CLASSIFIER_TIMEOUT_MS=9000
# Sí supportado por el modelo, baja el thinking (step-5-preview 5.3s con 'low').
# CLASSIFIER_REASONING_EFFORT=low
# DECOMPOSER_REASONING_EFFORT=low
DECOMPOSER_MAX_TOKENS=1200
# Timeout por request del LLM principal (modelo reasoning puede tardar).
ATLAS_LLM_TIMEOUT_MS=120000
# Streaming SSE del chat: el CLI muestra el reasoning en vivo (🧠 + línea dim).
# 0 = desactiva y vuelve al modo sin stream.
# ATLAS_LLM_STREAM=1

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=0

# ── Atlas ─────────────────────────────────────
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# ── Logging ───────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./data/logs

# ── Trust & safety ────────────────────────────
# 1=Cautious, 2=Safe, 3=Trusted (default), 4=Autonomous, 5=Night Shift
ATLAS_TRUST_LEVEL=3
# Comma or path-delimiter separated list of roots allowed for file tools.
# Defaults to the current working directory plus the OS temp directory.
# ATLAS_ALLOWED_ROOTS=./workspace:./data
# Disables the terminal safety checks. NOT recommended.
# ATLAS_ALLOW_DANGEROUS=false
